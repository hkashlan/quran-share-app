{
  "name": "khatmah-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:deps": "npx expo install --check",
    "check": "npm run typecheck && npm run check:deps",
    "generate-types": "bash scripts/generate-types.sh",
    "supabase-start": "npx supabase stop && npx supabase start",
    "supabase-sync": "npx supabase db push && npm run generate-types",
    "supabase-local-sync": "npx supabase db reset"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rneui/themed": "^5.0.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.2",
    "expo": "^55.0.17",
    "expo-constants": "~55.0.15",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-router": "^55.0.13",
    "expo-status-bar": "~55.0.5",
    "i18next": "^26.0.4",
    "react": "^19.0.0",
    "react-dom": "19.2.5",
    "react-i18next": "^17.0.2",
    "react-native": "0.83.6",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.1",
    "typescript": "~5.8.3"
  },
  "private": true
}
